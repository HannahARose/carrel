# Obsidian's per-device state in the sample archive; only app.json is shared
fixtures/sample-archive/.obsidian/*
!fixtures/sample-archive/.obsidian/app.json
fixtures/bench/archive/.obsidian/*
!fixtures/bench/archive/.obsidian/app.json

# carrel bench's default output
/bench-results/

# Rust build output, and the coverage data an instrumented test run leaves
/target/
*.profraw

# Built by scripts/build-xcframework.sh
/apple/CarrelKit/CarrelFFI.xcframework/

# Swift Package Manager and Xcode
.build/
.swiftpm/
*.xcuserstate
xcuserdata/

# Python bytecode, from running the scripts
__pycache__/

# Neovim help tags, made from editors/nvim/doc by plugin managers or :helptags
/editors/nvim/doc/tags
# Emacs byte-compiled files
*.elc

# Coverage data that test runs under llvm-cov leave behind.
*.profraw
